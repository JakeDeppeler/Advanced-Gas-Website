NEXT_PUBLIC_SITE_URL=https://www.advancedgas.com.au
LEAD_NOTIFICATION_EMAIL=admin@advancedgas.com
RESEND_API_KEY=

# ---- Google reviews (optional) ----------------------------------------
# When both are set, /reviews and the home page pull live 4★+ reviews from
# the Google Business profile and refresh every 24 h. Leave either blank and
# the site falls back to the curated list in src/lib/reviews.ts — nothing
# breaks, it just isn't live.
#
# 1. Create a key:  https://console.cloud.google.com/apis/credentials
# 2. Enable "Places API (New)" on that project.
# 3. Find the place ID:
#      GOOGLE_PLACES_API_KEY=xxx node scripts/find-place-id.mjs
#
# Note: Google returns a maximum of 5 reviews per place — that's their
# limit, not ours. We top the grid up from the curated list.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---- Address autocomplete (optional) ----------------------------------
# Falls back to OpenStreetMap Nominatim when unset.
MAPBOX_ACCESS_TOKEN=

# ---- Instagram install feed (optional) --------------------------------
# When set, brand pages and /gallery show live install photos straight
# from the Instagram account, refreshed every 6 h. Brand pages filter by
# caption — mention the brand (or hashtag it) and the post files itself.
#
# Needs a Business/Creator account. In the Meta app dashboard:
#   Use cases → add "Manage messaging & content on Instagram"
#   App roles → Roles → Instagram Testers → add the username,
#     then accept at instagram.com/accounts/manage_access/
#   Instagram → API setup with Instagram login → Generate token
#
# That button gives a 60-day long-lived token — paste it in as-is.
INSTAGRAM_ACCESS_TOKEN=

# Optional. The token already identifies the account, so leave this blank
# unless you're reading a different account's feed.
INSTAGRAM_USER_ID=

# Before the 60 days are up, extend it (no dashboard trip needed):
#   node scripts/instagram-token.mjs --refresh <current-token>
# If it lapses the feed just hides itself — nothing else breaks.

# ---- Analytics (all optional) -----------------------------------------
# Vercel Analytics needs no key: enable it in the Vercel dashboard under
# the project's Analytics tab and it starts collecting. ~1 KB, cookieless,
# so no consent banner needed.
#
# Google Analytics 4. Leave blank and the script never loads, which keeps
# ~45 KB off every page. Set it when you want to see which pages produce
# quote requests, or the day you start running Google Ads (Ads conversion
# tracking hangs off gtag).
#   Get it: analytics.google.com -> Admin -> Data streams -> your stream
#   Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console ownership, "HTML tag" verification method.
# Paste only the content value, not the whole meta tag.
# DNS verification is better where you control the domain because it
# survives a redesign; use this when you don't.
NEXT_PUBLIC_GSC_VERIFICATION=

# ---- Team portal (/portal) --------------------------------------------
# Secret used to sign the magic-link tokens and the session cookie. Set it
# to a long random string (e.g. `openssl rand -base64 32`). Without it, the
# portal login is disabled (fails closed).
PORTAL_AUTH_SECRET=
# The From address for the sign-in email (reuses Resend). Defaults to the
# Resend sandbox sender if unset.
RESEND_FROM_EMAIL=
# Optional: add team members / admins without a code change (comma-separated
# emails). The base list lives in src/lib/portal/team.ts.
PORTAL_TEAM=
PORTAL_ADMINS=

# --- Wall dashboard (/screen) -------------------------------------------------
# Reuses SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above.

# Long random string. Guards /screen and /api/screen; the TV's URL carries it
# as ?k=... Generate with: openssl rand -hex 32
SCREEN_TOKEN=

# The sync workflow sends this as `Authorization: Bearer $CRON_SECRET` to
# /api/sync. The same value must be set as a GitHub Actions repository secret.
CRON_SECRET=

# ServiceTitan — from the developer portal, once the tenant has connected the
# app. Until all four are set the sync skips ServiceTitan cleanly and the board
# runs on website leads alone.
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=
# Override both when pointing at ServiceTitan's integration (sandbox) environment.
# ST_AUTH_URL=https://auth-integration.servicetitan.io/connect/token
# ST_API_BASE=https://api-integration.servicetitan.io

# --- Reece API (see PRICEBOOK.md) ----------------------------------------------
# Issued by Reece (ConnectingCustomers@reece.com.au). Until the client id and
# secret are set, the price-file pull, search, PunchOut and invoice sync skip
# cleanly and an uploaded maX price file is the source of Reece pricing.
REECE_CLIENT_ID=
REECE_CLIENT_SECRET=
# Our Reece account number. Reece's model for a single-customer tool: it goes in
# a Customer-Number header on every call, no per-user login needed.
REECE_CUSTOMER_NUMBER=
# "production" (default) or "test". Reece issues separate credentials for each
# and they only work against their own hosts.
# REECE_ENV=production
# Override the hosts only if Reece says to. Defaults follow REECE_ENV.
# REECE_AUTH_URL=https://auth.api.reecegroup.com.au/oauth2/token
# REECE_API_BASE=https://open.api.reecegroup.com.au
# REECE_LINK_BASE=            browser-redirect host for onboarding/PunchOut pages
# REECE_REGION=au
# REECE_SCOPES=Default/read Default/write
# PunchOut: the clientId is Reece's "domain key" ({domainKey}.api.reecegroup.com.au);
# defaults to the client id. The secret rides in the hook URL so stray posts are
# rejected — generate with: openssl rand -hex 32
# REECE_DOMAIN_KEY=
REECE_PUNCHOUT_SECRET=
# MAX_CSV (default, goes through the same parser as a manual upload) or MAX_JSON.
# REECE_PRICE_FILE_FORMAT=MAX_CSV
