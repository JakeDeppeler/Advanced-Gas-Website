NEXT_PUBLIC_SITE_URL=https://www.advancedgas.com.au
LEAD_NOTIFICATION_EMAIL=admin@advancedgas.com
RESEND_API_KEY=

# --- Wall dashboard (/screen) -------------------------------------------------
# Supabase: the "advanced-calc" project, which holds the portal_* tables.
# The service-role key bypasses RLS — server-side only, never expose it.
SUPABASE_URL=https://pfvibwgusbfnjopqiszg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Long random string. Guards /screen and /api/screen; the TV's URL carries it
# as ?k=... Generate with: openssl rand -hex 32
SCREEN_TOKEN=

# Vercel Cron sends this as `Authorization: Bearer $CRON_SECRET` to /api/sync.
CRON_SECRET=

# ServiceTitan — from the developer portal, once the app is approved against
# the tenant. Until all four are set the sync skips ServiceTitan cleanly and
# the board runs on website leads alone.
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_TENANT_ID=
# Override both when pointing at ServiceTitan's integration (sandbox) environment.
# ST_AUTH_URL=https://auth.servicetitan.io/connect/token
# ST_API_BASE=https://api.servicetitan.io
