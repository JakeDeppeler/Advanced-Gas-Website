# Required ─────────────────────────────────────────────────────────────
# Public site URL (used in canonical tags, sitemap, Open Graph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.advancedgas.com.au

# Email setup ──────────────────────────────────────────────────────────
# Lead notifications (quote form + contact form + newsletter signups) go
# to every address listed here, separated by commas. Add as many as you
# like. Whitespace around the commas is fine.
#   e.g. admin@advancedgas.com.au, jake@example.com, kellie@example.com
LEAD_NOTIFICATION_EMAIL=admin@advancedgas.com.au

# Resend API key. Sign up at https://resend.com and paste the key here
# (looks like re_xxxxxxxxxxxxxxxxxxxx). If left blank the site keeps
# working — leads just get logged to the server console instead of
# emailed.
RESEND_API_KEY=

# "From" address for outgoing notifications.
# Use Resend's sandbox sender until your domain is verified — once
# advancedgas.com.au is verified inside Resend, switch this to
# "Advanced Gas Website <admin@advancedgas.com.au>".
RESEND_FROM_EMAIL=Advanced Gas Website <onboarding@resend.dev>
