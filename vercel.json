{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "crons": [
    {
      "path": "/api/reports/run",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/ordering/draft?mode=refresh",
      "schedule": "5 20 * * 0-4"
    },
    {
      "path": "/api/install-packs",
      "schedule": "15 20 * * 0-4"
    },
    {
      "path": "/api/email/outlook/sweep",
      "schedule": "40 19 * * *"
    },
    {
      "path": "/api/email/outlook/summary",
      "schedule": "40 6 * * 1-5"
    },
    {
      "path": "/api/reminders/daily",
      "schedule": "30 20 * * 0-4"
    }
  ]
}
